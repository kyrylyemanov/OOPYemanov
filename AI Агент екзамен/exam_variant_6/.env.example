# ============================================================
# GOOGLE GENERATIVE AI КОНФІГУРАЦІЯ
# ============================================================

# Google API Key для роботи з AI агентом
# Отримайте на https://ai.google.dev/
# Не комітьте цей файл з дійсним ключем!
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# НАЛАШТУВАННЯ ПРОЕКТУ
# ============================================================

# Назва проекту
PROJECT_NAME=Library Catalog Agent

# Режим налагодження (True/False)
DEBUG=False

# ============================================================
# ІНСТРУКЦІЇ ПО ОТРИМАННЮ API КЛЮЧА:
# ============================================================
# 1. Перейдіть на https://ai.google.dev/
# 2. Натисніть "Get API Key"
# 3. Виберіть/створіть проект
# 4. Скопіюйте API ключ
# 5. Замініть 'your_google_api_key_here' на ваш ключ
# 6. Збережіть файл як .env (без .example)
# 7. Запустіть: python agent.py

